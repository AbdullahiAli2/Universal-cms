# Copy to .env and replace every value marked CHANGE ME before deploying.

# --- Django API -------------------------------------------------------------
# CHANGE ME. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-long-random-value
# 0 in production. 1 only for local development.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,server
# Origins that may call the API directly (for example http://localhost:3000).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Set to 1 when the API sits behind an HTTPS reverse proxy.
DJANGO_BEHIND_HTTPS_PROXY=0
# HSTS lifetime in seconds. Leave 0 until HTTPS is permanent for this host.
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
# Days before an API token expires.
CMS_TOKEN_TTL_DAYS=14
# Sign-in attempts per minute per client address.
CMS_LOGIN_RATE=10/min
# Sign-in attempts per minute per account, from any address.
CMS_LOGIN_EMAIL_RATE=5/min
# Uploaded files and the largest upload, in MB (used by both the API and the dashboard proxy).
# CMS_MEDIA_ROOT=/data/media
# CMS_MAX_UPLOAD_MB=25
# Dashboard address, used in invitation emails.
# CMS_DASHBOARD_URL=https://cms.example.org
# Encrypts stored secrets (SMTP password). CHANGE ME in production to a long random value.
# CMS_ENCRYPTION_KEY=
# Public address of this API as your websites call it. Shown to website owners on the dashboard.
# CMS_PUBLIC_API_URL=https://cms.example.com/api/v1
GUNICORN_WORKERS=3

# --- Database ---------------------------------------------------------------
# postgres (recommended), sqlite (local development only), or mysql (optional).
CMS_DATABASE=postgres
# CHANGE ME
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
POSTGRES_DB=universal_cms
POSTGRES_USER=universal_cms
# Used when running the API outside Docker. Compose sets this to the db service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used only when CMS_DATABASE=sqlite. Relative paths are resolved from the server/ folder.
SQLITE_PATH=data/db.sqlite3

# --- Next.js dashboard ------------------------------------------------------
# Server-side address of the API. Compose overrides this to http://server:8000/api/v1.
CMS_API_URL=http://localhost:8000/api/v1
# The session cookie is Secure by default in production builds. Browsers accept Secure cookies on
# http://localhost, so leave this unset. Set false only to test over plain HTTP on another address.
# CMS_COOKIE_SECURE=false
# Extra origins allowed to sign in and make changes, if your reverse proxy rewrites the Host header.
# CMS_TRUSTED_ORIGINS=https://cms.example.com
